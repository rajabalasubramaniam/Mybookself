-    // Call DeepSeek API with streaming
-    const response = await fetch(`${deepseekConfig.baseURL}/chat/completions`, {
-      method: 'POST',
-      headers: {
-        'Content-Type': 'application/json',
-        'Authorization': `Bearer ${deepseekConfig.apiKey}`,
